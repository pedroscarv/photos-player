@echo off
chcp 65001 >nul
title PHOTOS PLAYER - Instalador portatil do menu
setlocal
set "PP_B64=%TEMP%\photos_player_setup.b64"
del "%PP_B64%" >nul 2>&1
echo.
echo ============================================================
echo    PHOTOS PLAYER - Instalando menu de contexto
echo ============================================================
echo.
echo(>> "%PP_B64%"
echo(>> "%PP_B64%"
echo(>> "%PP_B64%"
echo(>> "%PP_B64%"
echo(>> "%PP_B64%"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $dir=Join-Path $env:LOCALAPPDATA 'PhotosPlayer'; New-Item -ItemType Directory -Path $dir -Force | Out-Null; $b=[IO.File]::ReadAllText((Join-Path $env:TEMP 'photos_player_setup.b64')); $z=Join-Path $env:TEMP 'photos_player_setup.zip'; [IO.File]::WriteAllBytes($z,[Convert]::FromBase64String($b)); Expand-Archive -LiteralPath $z -DestinationPath $dir -Force; Remove-Item $z -Force; Remove-Item (Join-Path $env:TEMP 'photos_player_setup.b64') -Force; & (Join-Path $dir 'Instalar_Menu.ps1')"
if errorlevel 1 goto :erro
del "%PP_B64%" >nul 2>&1
echo.
set /p "RESP=Reiniciar o Explorer agora? [S/N]: "
if /i "%RESP%"=="S" (
  taskkill /f /im explorer.exe >nul 2>&1
  start explorer.exe
)
echo.
echo Instalacao concluida!
echo Pasta dos arquivos: %LOCALAPPDATA%\PhotosPlayer
goto :fim
:erro
echo.
echo Falha na instalacao.
:fim
del "%PP_B64%" >nul 2>&1
echo.
echo Pressione qualquer tecla para fechar...
pause >nul
